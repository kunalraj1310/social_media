<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SocialConnect</title>
  <link rel="icon" type="image/png" href="/images/logo.png">
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-br from-indigo-600 via-purple-600 to-pink-500 min-h-screen">

  <!-- Navbar -->
  <nav class="flex justify-between items-center px-8 py-5">
    <h1 class="text-3xl font-bold text-white">SocialConnect</h1>

    <div class="space-x-6 text-white font-medium hidden md:flex">
      <a href="#" class="hover:text-gray-200">Explore</a>
      <a href="/about" class="hover:text-gray-200">About</a>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="flex items-center justify-center px-6">
    <div class="text-center max-w-3xl mt-24">

      <h1 class="text-5xl md:text-7xl font-extrabold text-white leading-tight">
        Connect With
        <span class="text-yellow-300">People</span>
      </h1>

      <p class="mt-6 text-lg md:text-xl text-gray-100">
        Share moments, discover communities, and stay connected with
        friends around the world on one simple platform.
      </p>


      <a href="/register"
     class="inline-block bg-white text-indigo-600 font-bold px-8 py-4 mt-2 rounded-full text-lg shadow-lg hover:scale-105 hover:shadow-2xl transition duration-300">
        Start
        </a>
    </div>
  </section>

  <!-- Features -->
  <section class="max-w-6xl mx-auto px-6 mt-32 pb-16">
    <div class="grid md:grid-cols-3 gap-8">

      <div class="bg-white/10 backdrop-blur-md rounded-2xl p-6 text-white">
        <h3 class="text-xl font-semibold mb-3">🌍 Connect</h3>
        <p>Find and connect with people who share your interests.</p>
      </div>

      <div class="bg-white/10 backdrop-blur-md rounded-2xl p-6 text-white">
        <h3 class="text-xl font-semibold mb-3">📸 Share</h3>
        <p>Post photos, thoughts, and memorable moments instantly.</p>
      </div>

      <div class="bg-white/10 backdrop-blur-md rounded-2xl p-6 text-white">
        <h3 class="text-xl font-semibold mb-3">💬 Chat</h3>
        <p>Stay in touch with friends through real-time messaging.</p>
      </div>

    </div>
  </section>

</body>
</html>