<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Post | SocialConnect</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-gradient-to-br from-indigo-600 via-purple-600 to-pink-500">

    <!-- Logo -->
    <a href="/profile" class="absolute top-6 left-6 flex items-center gap-3">
        <div class="w-12 h-12 rounded-xl bg-white flex items-center justify-center shadow-lg">
            <span class="text-indigo-600 text-2xl font-bold">S</span>
        </div>

        <div>
            <h1 class="text-2xl font-extrabold text-white">
                SocialConnect
            </h1>
            <p class="text-xs text-gray-200">
                Connect • Share • Explore
            </p>
        </div>
    </a>

    <!-- Edit Form -->
    <div class="min-h-screen flex items-center justify-center px-4">

        <div class="w-full max-w-2xl bg-white rounded-3xl shadow-2xl p-8">

            <h1 class="text-4xl font-bold text-center text-gray-800 mb-2">
                Edit Post
            </h1>

            <p class="text-center text-gray-500 mb-8">
                Update your post and save changes
            </p>

            <form action="/update/<%= post._id %>" method="POST" class="space-y-6">

                <!-- Title -->
                <div>
                    <label class="block text-gray-700 font-medium mb-2">
                        Title
                    </label>

                    <input
                        type="text"
                        name="title"
                        value="<%= post.title %>"
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:outline-none"
                        required
                    >
                </div>

                <!-- Content -->
                <div>
                    <label class="block text-gray-700 font-medium mb-2">
                        Content
                    </label>

                    <textarea
                        name="postcontent"
                        rows="8"
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl resize-none focus:ring-2 focus:ring-indigo-500 focus:outline-none"
                        required
                    ><%= post.postcontent %></textarea>
                </div>

                <!-- Buttons -->
                <div class="flex gap-4">

                    <button
                        type="submit"
                        class="flex-1 bg-gradient-to-r from-indigo-600 to-purple-600 text-white py-3 rounded-xl font-semibold hover:scale-[1.02] transition duration-300">
                        💾 Save Changes
                    </button>

                    <a
                        href="/profile"
                        class="flex-1 text-center bg-gray-200 text-gray-700 py-3 rounded-xl font-semibold hover:bg-gray-300 transition">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</body>
</html>