<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Posts</title>
    <link rel="icon" href="/images/logo.png?v=2" type="image/png">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-gradient-to-br from-indigo-600 via-purple-600 to-pink-500">

    <!-- Navbar -->
    <div class="bg-white/10 backdrop-blur-md border-b border-white/20">
        <div class="max-w-6xl mx-auto px-6 py-4 flex justify-between items-center">

            <h1 class="text-3xl font-bold text-white">
                Hello, <%= user.username %> 👋
            </h1>

            <div class="flex gap-3">

                <a href="/profile"
                   class="bg-blue-500 hover:bg-blue-600 text-white px-5 py-2 rounded-xl font-medium transition">
                    All Posts
                </a>

                <a href="/posts"
                   class="bg-green-500 hover:bg-green-600 text-white px-5 py-2 rounded-xl font-medium transition">
                    Create Post
                </a>

                <a href="/logout"
                   class="bg-red-500 hover:bg-red-600 text-white px-5 py-2 rounded-xl font-medium transition">
                    Logout
                </a>

            </div>

        </div>
    </div>

    <!-- My Posts -->
    <div class="max-w-5xl mx-auto px-4 py-10">

        <h2 class="text-3xl font-bold text-white mb-8">
            My Posts
        </h2>

        <% if(user.post.length > 0){ %>

            <div class="space-y-6">

                <% user.post.forEach(function(post){ %>

                    <div class="bg-white rounded-2xl p-6 shadow-xl">

                        <div class="flex justify-between items-start mb-4">

                            <div>

                                <h3 class="text-2xl font-bold text-gray-800">
                                    <%= post.title %>
                                </h3>

                                <% if(post.date){ %>
                                    <p class="text-gray-400 text-sm mt-1">
                                        <%= post.date %>
                                    </p>
                                <% } %>

                            </div>

                        </div>

                        <p class="text-gray-700 leading-relaxed mb-6">
                            <%= post.postcontent %>
                        </p>

                        <div class="flex gap-3">

                            <a href="/like/<%= post._id %>"
                               class="bg-pink-100 text-pink-600 px-4 py-2 rounded-lg hover:bg-pink-200 transition">
                                ❤️ <%= post.likes.length %>
                            </a>

                            <a href="/edit/<%= post._id %>"
                               class="bg-indigo-100 text-indigo-600 px-4 py-2 rounded-lg hover:bg-indigo-200 transition">
                                ✏️ Edit
                            </a>

                            <a href="/delete/<%= post._id %>"
                               onclick="return confirm('Are you sure you want to delete this post?')"
                               class="bg-red-100 text-red-600 px-4 py-2 rounded-lg hover:bg-red-200 transition">
                                🗑️ Delete
                            </a>

                        </div>

                    </div>

                <% }) %>

            </div>

        <% } else { %>

            <div class="bg-white rounded-2xl p-10 text-center shadow-xl">

                <h3 class="text-2xl font-semibold text-gray-700">
                    No Posts Yet
                </h3>

                <p class="text-gray-500 mt-2">
                    Create your first post and start sharing.
                </p>

            </div>

        <% } %>

    </div>

</body>
</html>