<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>About - SocialConnect</title>
 <link rel="icon" type="image/png" href="/images/logo.png">
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50">

  <!-- Navbar -->
  <nav class="bg-white shadow-md">
    <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
      <h1 class="text-2xl font-bold text-indigo-600">
        SocialConnect
      </h1>

      <div class="space-x-6">
        <a href="/" class="text-gray-600 hover:text-indigo-600">Home</a>
        <a href="/about" class="text-indigo-600 font-semibold">About</a>
        <a href="/register" class="text-gray-600 hover:text-indigo-600">Register</a>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-500 text-white py-24">
    <div class="max-w-5xl mx-auto text-center px-6">
      <h1 class="text-5xl font-bold mb-6">
        About SocialConnect
      </h1>

      <p class="text-xl max-w-3xl mx-auto">
        SocialConnect is a modern social platform designed to help people
        connect, share ideas, and build meaningful communities online.
      </p>
    </div>
  </section>

  <!-- About Content -->
  <section class="max-w-6xl mx-auto px-6 py-20">

    <div class="grid md:grid-cols-2 gap-12 items-center">

      <div>
        <h2 class="text-4xl font-bold text-gray-800 mb-6">
          Our Mission
        </h2>

        <p class="text-gray-600 leading-8">
          We believe social media should bring people together in a positive
          and engaging way. Our mission is to create a platform where users
          can share experiences, discover new interests, and communicate
          freely with friends and communities.
        </p>
      </div>

      <div class="bg-white rounded-3xl shadow-xl p-8">
        <h3 class="text-2xl font-semibold text-indigo-600 mb-4">
          Why Choose Us?
        </h3>

        <ul class="space-y-4 text-gray-700">
          <li>✅ Easy and clean user experience</li>
          <li>✅ Connect with friends instantly</li>
          <li>✅ Share photos and updates</li>
          <li>✅ Secure and reliable platform</li>
          <li>✅ Community-driven environment</li>
        </ul>
      </div>

    </div>

  </section>

  <!-- Stats -->
  <section class="bg-white py-16">
    <div class="max-w-6xl mx-auto px-6">

      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">

        <div>
          <h3 class="text-4xl font-bold text-indigo-600">10K+</h3>
          <p class="text-gray-600 mt-2">Users</p>
        </div>

        <div>
          <h3 class="text-4xl font-bold text-indigo-600">50K+</h3>
          <p class="text-gray-600 mt-2">Posts Shared</p>
        </div>

        <div>
          <h3 class="text-4xl font-bold text-indigo-600">100+</h3>
          <p class="text-gray-600 mt-2">Communities</p>
        </div>

        <div>
          <h3 class="text-4xl font-bold text-indigo-600">24/7</h3>
          <p class="text-gray-600 mt-2">Support</p>
        </div>

      </div>

    </div>
  </section>

  <!-- CTA -->
  <section class="py-20">
    <div class="max-w-4xl mx-auto text-center px-6">

      <h2 class="text-4xl font-bold text-gray-800 mb-6">
        Ready to Join?
      </h2>

      <p class="text-gray-600 text-lg mb-8">
        Create your account today and become part of a growing community.
      </p>

      <a href="/register"
         class="inline-block bg-indigo-600 text-white px-8 py-4 rounded-xl font-semibold hover:bg-indigo-700 transition">
         Get Started
      </a>

    </div>
  </section>

</body>
</html>