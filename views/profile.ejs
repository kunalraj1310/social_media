<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Posts</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-gradient-to-br from-indigo-600 via-purple-600 to-pink-500">

    <!-- Navbar -->
    <div class="bg-white/10 backdrop-blur-md border-b border-white/20">
        <div class="max-w-6xl mx-auto px-6 py-4 flex justify-between items-center">

            <h1 class="text-3xl font-bold text-white">
                Hello, <%= user.username %> 👋
            </h1>

            <div class="flex gap-3">

                <a href="/myposts"
                   class="bg-blue-500 hover:bg-blue-600 text-white px-5 py-2 rounded-xl font-medium transition">
                    My Posts
                </a>

                <a href="/posts"
                   class="bg-green-500 hover:bg-green-600 text-white px-5 py-2 rounded-xl font-medium transition">
                    Create Post
                </a>

                <a href="/logout"
                   class="bg-red-500 hover:bg-red-600 text-white px-5 py-2 rounded-xl font-medium transition">
                    Logout
                </a>

            </div>

        </div>
    </div>

    <!-- Posts -->
    <div class="max-w-5xl mx-auto px-4 py-10">

        <h2 class="text-3xl font-bold text-white mb-8">
            All Posts
        </h2>

        <% if(allPosts.length > 0){ %>

            <div class="space-y-6">

                <% allPosts.forEach(function(post){ %>

                    <div class="bg-white rounded-2xl p-6 shadow-xl">

                        <div class="mb-4">

                            <h3 class="text-2xl font-bold text-gray-800">
                                <%= post.title %>
                            </h3>

                            <p class="text-gray-500 text-sm mt-1">
                                Posted by <%= post.user.username %>
                            </p>

                        </div>

                        <p class="text-gray-700 leading-relaxed mb-6">
                            <%= post.postcontent %>
                        </p>

                        <a href="/like/<%= post._id %>"
                           class="bg-pink-100 text-pink-600 px-4 py-2 rounded-lg hover:bg-pink-200 transition">
                            ❤️ <%= post.likes.length %>
                        </a>

                    </div>

                <% }) %>

            </div>

        <% } else { %>

            <div class="bg-white rounded-2xl p-10 text-center shadow-xl">

                <h3 class="text-2xl font-semibold text-gray-700">
                    No Posts Available
                </h3>

            </div>

        <% } %>

    </div>

</body>
</html>